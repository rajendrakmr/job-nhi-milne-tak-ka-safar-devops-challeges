<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%- todo %></title>
    <style>
      /* Global Styles */
      * {
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        background: linear-gradient(135deg, #74ebd5, #acb6e5);
        color: #333;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
      }

      h1 {
        background-color: rgba(255, 255, 255, 0.9);
        color: #333;
        margin: 0;
        padding: 20px 40px;
        text-align: center;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        margin-top: 40px;
      }

      .container {
        width: 90%;
        max-width: 500px;
        background: white;
        border-radius: 16px;
        margin-top: 30px;
        padding: 25px 30px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
      }

      label {
        font-weight: 600;
        color: #444;
        display: block;
        margin-bottom: 8px;
      }

      input[type="text"] {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 15px;
        margin-bottom: 16px;
        transition: all 0.2s ease-in-out;
      }

      input[type="text"]:focus {
        border-color: #74b9ff;
        outline: none;
        box-shadow: 0 0 6px rgba(116, 185, 255, 0.5);
      }

      input[type="submit"] {
        background: linear-gradient(135deg, #4caf50, #2e7d32);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
      }

      input[type="submit"]:hover {
        background: linear-gradient(135deg, #43a047, #1b5e20);
        transform: scale(1.03);
      }

      a {
        display: inline-block;
        margin-top: 16px;
        text-decoration: none;
        color: #0078ff;
        font-weight: 500;
      }

      a:hover {
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <h1>Edit Task</h1>

    <div class="container">
      <form action="/todo/edit/<%= todoIdx %>" method="post">
        <input type="hidden" name="_method" value="PUT" />

        <label for="editTodo">Change "<%- todo %>" to:</label>
        <input
          type="text"
          name="editTodo"
          id="editTodo"
          value="<%- todo %>"
          placeholder="Enter new task"
          autofocus
          required
        />

        <input type="submit" value="Save Changes" />
      </form>

      <a href="/todo">← Back to List</a>
    </div>
  </body>
</html>
