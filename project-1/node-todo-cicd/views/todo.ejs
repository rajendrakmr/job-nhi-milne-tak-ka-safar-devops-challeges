<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Todo List App</title>
    <style>
      /* Global Styles */
      * {
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        background: linear-gradient(135deg, #74ebd5, #acb6e5);
        color: #333;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
      }

      h1 {
        background-color: rgba(255, 255, 255, 0.9);
        color: #333;
        margin: 0;
        padding: 20px 40px;
        text-align: center;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        margin-top: 40px;
      }

      .container {
        width: 90%;
        max-width: 600px;
        background: white;
        border-radius: 16px;
        margin-top: 30px;
        padding: 25px 30px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
      }

      ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      ul li {
        background: #f8f9fa;
        border: 1px solid #eee;
        margin-bottom: 10px;
        padding: 14px 16px;
        border-radius: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s ease;
      }

      ul li:hover {
        transform: scale(1.02);
        background: #e9f5ee;
        border-color: #cce3d4;
      }

      .todo-text {
        flex: 1;
        font-size: 16px;
      }

      .actions {
        display: flex;
        gap: 12px;
      }

      .edit-btn,
      .delete-btn {
        border: none;
        background: none;
        font-size: 18px;
        cursor: pointer;
        transition: 0.2s;
      }

      .edit-btn {
        color: #ffc107;
      }

      .delete-btn {
        color: #e74c3c;
      }

      .edit-btn:hover {
        transform: scale(1.2);
      }

      .delete-btn:hover {
        transform: scale(1.2);
      }

      form {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      label {
        font-weight: 600;
        color: #444;
      }

      input[type="text"] {
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 15px;
      }

      input[type="text"]:focus {
        border-color: #74b9ff;
        outline: none;
        box-shadow: 0 0 6px rgba(116, 185, 255, 0.5);
      }

      input[type="submit"] {
        background: linear-gradient(135deg, #4caf50, #2e7d32);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
      }

      input[type="submit"]:hover {
        background: linear-gradient(135deg, #43a047, #1b5e20);
        transform: scale(1.03);
      }
    </style>
  </head>

  <body>
    <h1>💻 DevOps 90 Days Challenge - Todo List</h1>

    <div class="container">
      <ul>
        <% todolist.forEach(function(todo, index) { %>
        <li>
          <span class="todo-text"><%- todo %></span>
          <div class="actions">
            <a href="/todo/<%= index %>" class="edit-btn">✎</a>
            <a href="/todo/delete/<%= index %>" class="delete-btn">✘</a>
          </div>
        </li>
        <% }); %>
      </ul>

      <form action="/todo/add/" method="post">
        <label for="newtodo">Add a new task</label>
        <input
          type="text"
          name="newtodo"
          id="newtodo"
          placeholder="e.g., Automate Jenkins pipeline..."
          autofocus
        />
        <input type="submit" value="Add Task" />
      </form>
    </div>
  </body>
</html>
